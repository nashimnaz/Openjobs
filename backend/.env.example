# OpenJobs Backend Environment Configuration
# Copy this file to .env and configure your secrets locally.
# Never commit .env or database passwords to version control.

# Django Core Settings
SECRET_KEY=replace-with-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_NAME=openjobs_dev
DB_USER=openjobs_app
DB_PASSWORD=your_openjobs_app_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
